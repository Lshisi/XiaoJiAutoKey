# Build output
build/
dist/
firmware/pico/build/
firmware/ch552/build/

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln.docstates

# Compiled files
*.obj
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk

# Bundled WinUSB installer is embedded into the main executable.
!firmware/updater/
!firmware/updater/xiaoji-winusb-installer.exe

# libwdi sources are kept locally for provenance; the shipped installer is
# already built and embedded, so only the license texts are tracked.
third_party/libwdi/*
!third_party/libwdi/COPYING
!third_party/libwdi/COPYING-LGPL

# Keep bundled DD runtime DLLs in version control
!third_party/dd/DD32.dll
!third_party/dd/DD64.dll
!third_party/dd/hid/
!third_party/dd/hid/**
!third_party/inf

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Qt generated
*_autogen/
moc_*.cpp
ui_*.h
qrc_*.cpp

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Build output log
build_output.txt

# Local firmware/toolchain downloads
/tools/

# Config files (user-specific)
config.json

# Kiro
.kiro/
