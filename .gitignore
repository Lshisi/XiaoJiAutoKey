# Build output
build/
build-*/
out/
dist/
firmware/pico/build/
firmware/ch552/build/

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln.docstates

# Compiled files
*.obj
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.idb
*.ipch
*.pch
*.iobj
*.ipdb
*.tlog
*.lastbuildstate

# Local libwdi source checkout; only the license texts are tracked.
third_party/libwdi/*
!third_party/libwdi/COPYING
!third_party/libwdi/COPYING-LGPL

# Keep plugin driver dependencies in version control
!plugins/driver-dd/driver/DD32.dll
!plugins/driver-dd/driver/DD64.dll
!plugins/driver-dd/driver/inf/*/dc64.exe
!plugins/driver-xiaoji/third_party/xiaoji/driver/xiaoji.dll

# CMake generated
plugins/*/build*/
sdk/build*/
CMakeCache.txt
CMakeUserPresets.json
CMakeFiles/
cmake_install.cmake
compile_commands.json

# Qt generated
*_autogen/
moc_*.cpp
ui_*.h
qrc_*.cpp

# Python generated
__pycache__/
*.pyc
*.pyo

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Local logs and temporary files
build_output.txt
*.log
*.tmp
*.bak
*.orig
*.rej
*~

# Local firmware/toolchain downloads
/tools/

# Config files (user-specific)
config.json

# Local credentials and private signing material (public registry key is tracked)
.env
.env.*
!.env.example
!.env.template
*.dpapi
*.pfx
*.p12
*.key
*-private.pem
*private-key*.pem
*signing-key*.pem

# Generated plugin payloads and local runtime state
/plugins/builtin/
/plugins/installed/
plugin-data/
plugin-cache/
/registry/.cache/
/registry/dist/
.cache/

# Kiro
.kiro/

# Local assistant settings
.claude/settings.local.json
.zcode/

# Local timestamp authority artifacts
_tsa/
*.tsq
*.tsr

# Driver build output
driver/xiaoji-vhid/obj/
driver/xiaoji-vhid/package/
