[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%ProviderName%
CatalogFile=XiaoJiVhid.cat
DriverVer=07/31/2026,1.0.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
XiaoJiVhid.sys=1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0

[Standard.NTamd64.10.0]
%DeviceName%=XiaoJiVhid_Install,Root\XiaoJiVhid

[XiaoJiVhid_Install.NT]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
XiaoJiVhid.sys

[XiaoJiVhid_Install.NT.Services]
AddService=XiaoJiVhid,0x00000002,XiaoJiVhid_Service

[XiaoJiVhid_Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\XiaoJiVhid.sys

[XiaoJiVhid_Install.NT.Wdf]
KmdfService=XiaoJiVhid,XiaoJiVhid_Wdf

[XiaoJiVhid_Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
ProviderName="XiaoJi"
ManufacturerName="XiaoJi"
DeviceName="XiaoJi HID Input Device"
ServiceName="XiaoJi HID Driver"
DiskName="XiaoJi HID Driver Package"
